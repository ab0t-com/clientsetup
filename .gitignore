# Local agent / editor settings — never published
.claude/
.idea/
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Build scratch
*.tmp
*.log

# Real (non-.example) service configs — only the .example schema refs ship.
# The binary writes credentials to ~/.authmesh/<service>/, outside any repo.
# (credentials/ is NOT ignored here — its own credentials/.gitignore keeps the
#  .example docs and ignores only real *.json, same as the rest of the kit.)
config/permissions.json
config/oauth-client.json
config/hosted-login.json
config/api-consumers.json
config/org-structure.json

# Note: release/authsetup-* ARE intentionally committed — the prebuilt binaries
# are the point of this repo. Do not ignore release/.
